{
  "name": "book-manager-react",
  "version": "3.0.0",
  "private": true,
  "packageManager": "pnpm@10.29.2",
  "type": "module",
  "description": "방구석 도서관리 - Electrobun + SQLite 데스크탑 앱",
  "scripts": {
    "dev": "node tooling/scripts/dev.mjs",
    "build": "pnpm licenses:generate && pnpm check:architecture && pnpm type-check && vite build --config tooling/config/vite.config.ts",
    "licenses:generate": "node tooling/scripts/generate-open-source-notices.mjs",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "type-check": "tsc --noEmit && tsc -p desktop && tsc -p tooling",
    "check:architecture": "node tooling/scripts/check-architecture.mjs",
    "test": "vitest --config tooling/config/vitest.config.ts",
    "test:run": "vitest run --config tooling/config/vitest.config.ts",
    "test:coverage": "vitest run --coverage --config tooling/config/vitest.config.ts",
    "test:e2e": "playwright test --config tooling/config/playwright.config.ts",
    "storybook": "storybook dev -p 6006 --config-dir tooling/storybook",
    "build-storybook": "storybook build --config-dir tooling/storybook --output-dir build/storybook",
    "desktop:prepare": "electrobun prepare",
    "desktop:build": "pnpm build && electrobun build --env=dev",
    "desktop:start": "electrobun run",
    "desktop:release": "pnpm build && electrobun build --env=stable",
    "test:desktop": "bun test desktop"
  },
  "dependencies": {
    "@hookform/resolvers": "^3.9.1",
    "@tanstack/react-query": "^5.62.3",
    "@tanstack/react-virtual": "^3.13.18",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "jotai": "^2.10.3",
    "lucide-react": "^0.454.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-hook-form": "^7.54.0",
    "react-router-dom": "^6.30.6",
    "recharts": "^2.13.3",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@playwright/test": "^1.56.1",
    "@storybook/addon-docs": "^10.6.4",
    "@storybook/addon-links": "^10.6.4",
    "@storybook/react-vite": "^10.6.4",
    "@tailwindcss/aspect-ratio": "^0.4.2",
    "@tailwindcss/forms": "^0.5.9",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/bun": "^1.4.4",
    "@types/node": "^26.6.5",
    "@types/react": "^19.0.1",
    "@types/react-dom": "^19.0.1",
    "@vitejs/plugin-react-swc": "^3.7.2",
    "@vitest/coverage-v8": "^4.0.9",
    "@vitest/ui": "^4.0.9",
    "autoprefixer": "^10.4.20",
    "bun": "1.4.4",
    "electrobun": "2.0.4",
    "jsdom": "^27.2.0",
    "postcss": "^8.4.49",
    "storybook": "^10.6.4",
    "tailwindcss": "^3.4.15",
    "typescript": "^5.7.2",
    "vite": "^6.0.1",
    "vitest": "^4.0.9"
  },
  "engines": {
    "node": ">=26.12.1 <27",
    "pnpm": ">=8.0.0"
  },
  "pnpm": {
    "overrides": {
      "@remix-run/router": "1.23.2",
      "lodash": "4.17.23"
    },
    "onlyBuiltDependencies": ["bun"]
  }
}
