{
  "name": "book-manager-react",
  "version": "3.0.0",
  "private": true,
  "packageManager": "pnpm@10.29.2",
  "type": "module",
  "description": "방구석 도서관리 - Electrobun + SQLite 데스크탑 앱",
  "scripts": {
    "dev": "pnpm build && electrobun run",
    "build": "node tooling/packaging/desktop.mjs",
    "check": "biome check . && tsc --noEmit && tsc -p desktop && tsc -p tooling && node tooling/checks/architecture.mjs",
    "format": "biome format --write .",
    "test": "vitest --config tooling/config/vitest.config.ts",
    "test:e2e": "playwright test --config tooling/config/playwright.config.ts",
    "test:desktop": "bun test desktop",
    "storybook": "storybook dev -p 6006 --config-dir tooling/storybook"
  },
  "dependencies": {
    "@hookform/resolvers": "^6.0.2",
    "@tanstack/react-query": "^5.105.0",
    "@tanstack/react-virtual": "^3.14.23",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "jotai": "^3.0.1",
    "lucide-react": "^1.63.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-hook-form": "^7.91.0",
    "react-router-dom": "^7.18.5",
    "recharts": "^3.10.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.3",
    "@playwright/test": "^1.64.1",
    "@storybook/addon-docs": "^10.6.5",
    "@storybook/react-vite": "^10.6.5",
    "@tailwindcss/forms": "^0.5.11",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/bun": "^1.4.4",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^5.0.5",
    "@vitest/ui": "^5.0.5",
    "bun": "1.4.4",
    "electrobun": "2.0.5",
    "jsdom": "^30.1.3",
    "storybook": "^10.6.5",
    "tailwindcss": "^4.3.3",
    "typescript": "6.0.3",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=26.12.1 <27",
    "pnpm": ">=8.0.0"
  },
  "pnpm": {
    "overrides": {
      "rollup": "4.65.1"
    },
    "onlyBuiltDependencies": [
      "bun"
    ]
  }
}
